{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "EnableProxyResponseBodyCapture": true,
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": "demo123"
      }
    },
    "Storage": {
      "Provider": "Sqlite", // "Sqlite" | "Redis"
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db;Password=123456" },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "Prefix": "aneiang:",
        "Database": 0
      }
    },
    "Deployment": {
      "Mode": "Split",
      "EndpointRoles": {
        "Proxy": "Proxy",
        "Dashboard": "Dashboard"
      },
      "RequireLoopbackForDashboard": false,
      "HealthCheck": { "Enabled": true },
      "HotReload": { "Enabled": true }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Proxy": { "Url": "http://0.0.0.0:5202" },
      "Dashboard": { "Url": "http://0.0.0.0:5200" }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sample-local-service": {
        "Match": {
          "Path": "/api/local-service/{**catch-all}"
        },
        "Order": 2147483647,
        "ClusterId": "sample-local-service"
      }
    },
    "Clusters": {
      "sample-local-service": {
        "Destinations": {
          "d1": {
            "Address": "http://192.168.202.66:8001/"
          }
        }
      }
    }
  }
}

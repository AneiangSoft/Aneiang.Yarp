@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "WAF Firewall" : "WAF 防火墙";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="waf-app">
    <div class="page-help-bar" id="waf-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.waf">WAF 防火墙配置，拦截恶意请求。支持 SQL 注入、XSS、路径遍历等攻击防护。</span>
        <button class="help-close" onclick="document.getElementById('waf-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-shield-lock me-2 text-danger"></i><span data-i18n="waf.title">WAF 防火墙</span></span>
            <div class="card-header-actions">
                <span id="waf-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-primary btn-icon-only" onclick="WafModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div id="waf-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="pluginPage.loading">加载中...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/plugin-binding-manager.js"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-waf.js"></script>
@await Html.PartialAsync("_DashboardPageInit")
<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        await WafModule.load();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

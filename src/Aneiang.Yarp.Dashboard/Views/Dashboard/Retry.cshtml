@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Request Retry" : "请求重试";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="retry-app">
    <div class="page-help-bar" id="retry-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.retry">请求重试配置，请求失败后自动重试。支持指数退避策略。</span>
        <button class="help-close" onclick="document.getElementById('retry-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-arrow-repeat me-2 text-primary"></i><span data-i18n="retry.title">请求重试</span></span>
            <div class="card-header-actions">
                <span id="retry-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-primary btn-icon-only" onclick="RetryModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div id="retry-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="pluginPage.loading">加载中...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/plugin-binding-manager.js"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-retry.js"></script>
@await Html.PartialAsync("_DashboardPageInit")
<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        await RetryModule.load();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

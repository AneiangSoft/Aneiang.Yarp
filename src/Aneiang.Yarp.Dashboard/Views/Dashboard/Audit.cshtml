@using Aneiang.Yarp.Plugin.ProxyLog.Models
@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Audit Log" : "审计日志";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Audit log page -->
<div class="dash-page-head">
    <h1 class="dash-page-head-title"><i class="bi bi-shield-check"></i><span data-i18n="audit.title">审计日志</span></h1>
    <div class="pc-panel-actions">
        <span class="plg-plugin-id audit-refresh-time" id="audit-refresh-time"></span>
        <button class="pr-refresh-btn" onclick="window.AuditModule.loadAuditLogs()" title="刷新" data-i18n-title="index.btn.refresh"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
</div>
<div class="pc-meta-line" id="audit-meta-line"></div>
<div id="audit-content">
    <div class="loading-state">
        <div class="loading-spinner"></div>
        <div class="loading-text" data-i18n="audit.loading">加载中...</div>
    </div>
</div>

@section Scripts {
@{ var v = typeof(LogEntry).Assembly.GetName().Version?.ToString() ?? DateTime.Now.Ticks.ToString(); }
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-audit.js?v=@v"></script>

@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();

        if (window.DashboardApp?.modules?.audit?.init) await DashboardApp.modules.audit.init();
        if (window.AuditModule?.loadAuditLogs) await AuditModule.loadAuditLogs();

        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

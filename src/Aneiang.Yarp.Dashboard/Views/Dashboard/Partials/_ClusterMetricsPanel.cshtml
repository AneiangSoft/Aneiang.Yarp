@* Partial: ClusterMetrics monitor panel (no config sub-panel - managed by PluginCenter) *@
<div id="cluster-metrics-app">
    <div class="plugin-hint-banner" id="cm-plugin-hint">
        <i class="bi bi-info-circle"></i>
        <span data-i18n="common.pluginNotConfigured">未配置插件，数据可能为空</span>
        <a href="/@ViewBag.DashboardRoutePrefix/plugin-center#cluster-metrics" class="plugin-hint-link" data-i18n="common.goPluginConfig">前往配置 <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="pc-panel-head">
        <div class="pc-panel-title"><i class="bi bi-diagram-3-fill me-2 text-primary"></i><span data-i18n="clusterMetrics.title">集群指标</span></div>
        <div class="pc-panel-actions">
            <span id="cm-refresh-time" class="refresh-badge"></span>
            <button class="pr-refresh-btn" onclick="ClusterMetricsModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
    <div id="cm-content">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="pluginPage.loading">加载中...</div>
            </div>
        </div>
    </div>
    <div class="pc-feature-config" data-plugin="cluster-metrics"></div>
</div>

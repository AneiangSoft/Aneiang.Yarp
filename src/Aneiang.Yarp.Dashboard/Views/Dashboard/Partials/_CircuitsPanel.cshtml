@* Partial: Circuits monitor panel (no config sub-panel - managed by PluginCenter) *@
<div id="circuits-app">
    <div class="page-help-bar" id="circuits-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.circuits">熔断器监控页面，展示每个集群的熔断状态。当后端服务异常时，熔断器会自动断开请求以保护系统。</span>
        <button class="help-close" onclick="document.getElementById('circuits-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="plugin-hint-banner" id="circuit-plugin-hint">
        <i class="bi bi-info-circle"></i>
        <span data-i18n="common.pluginNotConfigured">未配置插件，数据可能为空</span>
        <a href="/@ViewBag.DashboardRoutePrefix/plugin-center#circuit-breaker" class="plugin-hint-link" data-i18n="common.goPluginConfig">前往配置 <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-lightning-charge me-2" style="color:#f59e0b;"></i><span data-i18n="circuit.title">熔断状态</span></span>
            <div class="card-header-actions">
                <span id="circuit-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-primary" onclick="CircuitModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="CircuitModule.resetAll()" data-i18n-title="circuit.reset" title="重置">
                    <i class="bi bi-x-circle"></i> <span data-i18n="circuit.reset">全部重置</span>
                </button>
            </div>
        </div>
        <div id="circuit-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="circuit.loading">加载中...</div>
            </div>
        </div>
    </div>
    <div class="pc-feature-config" data-plugin="circuits"></div>
</div>

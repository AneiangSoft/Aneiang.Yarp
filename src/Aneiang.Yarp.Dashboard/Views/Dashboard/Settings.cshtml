@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Settings" : "系统设置";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="settings-app">
    <div class="page-help-bar" id="settings-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.settings">系统设置包含账号安全、日志采集与数据持久化策略，以及系统运行信息。</span>
        <button class="help-close" onclick="document.getElementById('settings-help-bar').classList.add('collapsed')">&times;</button>
    </div>

    <ul class="nav nav-tabs settings-tabs" id="settings-tab-nav" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-security" data-bs-toggle="tab" data-bs-target="#pane-security" type="button" role="tab" aria-controls="pane-security" aria-selected="true">
                <i class="bi bi-shield-lock"></i><span data-i18n="settings.tab.security">账号安全</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-logging" data-bs-toggle="tab" data-bs-target="#pane-logging" type="button" role="tab" aria-controls="pane-logging" aria-selected="false">
                <i class="bi bi-journal-text"></i><span data-i18n="settings.tab.logging">日志与持久化</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-system" data-bs-toggle="tab" data-bs-target="#pane-system" type="button" role="tab" aria-controls="pane-system" aria-selected="false">
                <i class="bi bi-info-circle"></i><span data-i18n="settings.tab.system">系统信息</span>
            </button>
        </li>
    </ul>

    <div class="tab-content settings-tab-content" id="settings-tab-content">
        <!-- TAB: 账号安全 (2FA) -->
        <div class="tab-pane fade show active" id="pane-security" role="tabpanel" aria-labelledby="tab-security">
            <div class="card-panel mb-4">
                <div class="card-header">
                    <span><i class="bi bi-shield-lock me-2" style="color:#f59e0b;"></i><span data-i18n="twofa.title">双因素认证 (2FA)</span></span>
                    <div class="card-header-actions">
                        <span id="twofa-status-badge" class="badge bg-secondary" data-i18n="common.loading">加载中</span>
                    </div>
                </div>
                <div id="twofa-content" class="card-body">
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <div class="loading-text" data-i18n="common.loading">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: 日志与数据持久化 -->
        <div class="tab-pane fade" id="pane-logging" role="tabpanel" aria-labelledby="tab-logging">
            <div class="card-panel mb-4">
                <div class="card-header">
                    <span><i class="bi bi-journal-text me-2 text-success"></i><span data-i18n="settings.logging">日志与数据持久化</span></span>
                    <div class="card-header-actions">
                        <span id="settings-customized-badge" class="badge rounded-pill bg-warning-subtle text-warning-emphasis d-none" data-i18n="settings.logging.customizedBadge">已自定义</span>
                    </div>
                </div>
                <div class="card-body">
                    <!-- 分组1: 持久化与保留策略 -->
                    <div class="settings-form-section">
                        <div class="settings-group-title">
                            <i class="bi bi-database-check text-primary"></i>
                            <span data-i18n="settings.logging.group.persistence">持久化与保留策略</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="settings-card settings-card--blue">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="ls-persistence">
                                        <label class="form-check-label fw-semibold" for="ls-persistence" data-i18n="settings.logging.persistenceEnabled">日志持久化</label>
                                    </div>
                                    <div class="form-text" data-i18n="settings.logging.persistenceEnabled.desc">关闭后日志仅在内存中保留，不写入数据库。</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-card settings-card--blue">
                                    <label class="form-label" for="ls-meta-retention" data-i18n="settings.logging.metaRetentionDays">元数据保留天数</label>
                                    <input type="number" class="form-control" id="ls-meta-retention" min="1" max="365">
                                    <div class="form-text">1 - 365 天</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-card settings-card--blue">
                                    <label class="form-label" for="ls-body-retention" data-i18n="settings.logging.bodyRetentionDays">大字段保留天数</label>
                                    <input type="number" class="form-control" id="ls-body-retention" min="1" max="365">
                                    <div class="form-text">1 - 365 天</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 分组2: 请求/响应体捕获 -->
                    <div class="settings-form-section">
                        <div class="settings-group-title">
                            <i class="bi bi-file-earmark-text text-success"></i>
                            <span data-i18n="settings.logging.group.bodyCapture">请求/响应体捕获</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="settings-card settings-card--green">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="ls-req-body">
                                        <label class="form-check-label" for="ls-req-body" data-i18n="settings.logging.requestBodyCapture">请求体捕获</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="ls-resp-body">
                                        <label class="form-check-label" for="ls-resp-body" data-i18n="settings.logging.responseBodyCapture">响应体捕获</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="settings-card settings-card--green">
                                    <label class="form-label" for="ls-max-body" data-i18n="settings.logging.maxBodyLength">Body 最大长度</label>
                                    <input type="number" class="form-control" id="ls-max-body" min="1024" step="1024">
                                    <div class="form-text">字节</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="settings-card settings-card--green">
                                    <label class="form-label" for="ls-buffer" data-i18n="settings.logging.maxBodyBufferBytes">Body 缓冲区</label>
                                    <input type="number" class="form-control" id="ls-buffer" min="1024" step="1024">
                                    <div class="form-text">字节</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 分组3: 采样与过滤 -->
                    <div class="settings-form-section">
                        <div class="settings-group-title">
                            <i class="bi bi-filter-amber text-warning"></i>
                            <span data-i18n="settings.logging.group.sampling">采样与过滤</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="settings-card settings-card--amber">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="ls-sampling">
                                        <label class="form-check-label fw-semibold" for="ls-sampling" data-i18n="settings.logging.samplingEnabled">启用采样</label>
                                    </div>
                                    <div class="form-text" data-i18n="settings.logging.samplingEnabled.desc">仅按比例记录日志，降低存储压力。</div>
                                    <label class="form-label mt-3" for="ls-sampling-rate" data-i18n="settings.logging.samplingRate">采样率</label>
                                    <input type="number" class="form-control" id="ls-sampling-rate" min="0.01" max="1" step="0.01">
                                    <div class="form-text">0.01 - 1.0</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-card settings-card--amber">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" id="ls-errors-only">
                                        <label class="form-check-label fw-semibold" for="ls-errors-only" data-i18n="settings.logging.errorsOnly">仅记录错误</label>
                                    </div>
                                    <div class="form-text" data-i18n="settings.logging.errorsOnly.desc">仅记录状态码 ≥ 400 的请求。</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="settings-card settings-card--amber">
                                    <label class="form-label" for="ls-min-level" data-i18n="settings.logging.minLogLevel">最小日志级别</label>
                                    <select class="form-select" id="ls-min-level">
                                        <option value="Trace" data-i18n="settings.logging.level.trace">Trace</option>
                                        <option value="Information" data-i18n="settings.logging.level.information">Information</option>
                                        <option value="Warning" data-i18n="settings.logging.level.warning">Warning</option>
                                        <option value="Error" data-i18n="settings.logging.level.error">Error</option>
                                        <option value="Critical" data-i18n="settings.logging.level.critical">Critical</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 操作按钮 -->
                    <div class="settings-actions">
                        <button class="btn btn-primary" id="settings-save-btn" onclick="SettingsModule.save()">
                            <i class="bi bi-check-lg me-1"></i><span data-i18n="settings.logging.save">保存日志设置</span>
                        </button>
                        <button class="btn btn-outline-warning" id="settings-reset-btn" onclick="SettingsModule.reset()">
                            <i class="bi bi-arrow-counterclockwise me-1"></i><span data-i18n="settings.logging.reset">重置为默认</span>
                        </button>
                    </div>

                    <!-- 数据管理 -->
                    <hr class="settings-divider">
                    <div class="settings-form-section">
                        <div class="settings-group-title">
                            <i class="bi bi-download text-info"></i>
                            <span data-i18n="settings.logging.dataManagement">数据管理</span>
                        </div>
                        <button class="btn btn-outline-secondary" onclick="SettingsModule.downloadDatabase()">
                            <i class="bi bi-download me-1"></i><span data-i18n="settings.logging.downloadDb">下载 SQLite 数据库</span>
                        </button>
                    </div>

                    <!-- 需重启配置 -->
                    <hr class="settings-divider">
                    <div class="settings-form-section">
                        <div class="settings-group-title">
                            <i class="bi bi-arrow-repeat text-muted"></i>
                            <span data-i18n="settings.logging.restartRequired">需重启生效的配置</span>
                            <span class="badge rounded-pill bg-light text-muted border ms-2" style="font-size:11px;font-weight:500;" data-i18n="settings.logging.restartRequired.badge">只读 · appsettings.json</span>
                        </div>
                        <div class="form-text mb-3" data-i18n="settings.logging.restartRequired.desc">以下配置来自 appsettings.json，修改后需重启服务才能生效。</div>
                        <div id="settings-restart-required" class="restart-required-grid"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: 系统信息 -->
        <div class="tab-pane fade" id="pane-system" role="tabpanel" aria-labelledby="tab-system">
            <div class="card-panel mb-4">
                <div class="card-header">
                    <span><i class="bi bi-info-circle me-2 text-info"></i><span data-i18n="settings.system">系统信息</span></span>
                </div>
                <div class="card-body">
                    <div id="settings-system-content">
                        <div class="loading-state">
                            <div class="loading-spinner"></div>
                            <div class="loading-text" data-i18n="pluginPage.loading">加载中...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-settings.js"></script>
<!-- QRCode for 2FA setup (vendored locally - no CDN dependency for intranet) -->
<script src="/_content/Aneiang.Yarp.Dashboard/js/vendor/qrcode.min.js" onerror="console.warn('[2FA] local qrcode lib failed to load, will fall back to manual secret entry')"></script>
<!-- Two-factor authentication module (account security card) -->
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-twofactor.js"></script>
@await Html.PartialAsync("_DashboardPageInit")
<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        await SettingsModule.load();
        if (window.TwoFactorModule) {
            TwoFactorModule.load().catch(function() {});
        }
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Settings" : "系统设置";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="settings-app">
    <div class="page-help-bar" id="settings-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.settings">系统设置包含账号安全、日志采集与数据持久化策略，以及系统运行信息。</span>
        <button class="help-close" onclick="document.getElementById('settings-help-bar').classList.add('collapsed')">&times;</button>
    </div>

    <ul class="nav nav-pills settings-tabs" id="settings-tab-nav" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-security" data-bs-toggle="tab" data-bs-target="#pane-security" type="button" role="tab" aria-controls="pane-security" aria-selected="true">
                <i class="bi bi-shield-lock"></i><span data-i18n="settings.tab.security">账号安全</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-logging" data-bs-toggle="tab" data-bs-target="#pane-logging" type="button" role="tab" aria-controls="pane-logging" aria-selected="false">
                <i class="bi bi-journal-text"></i><span data-i18n="settings.tab.logging">日志与持久化</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-system" data-bs-toggle="tab" data-bs-target="#pane-system" type="button" role="tab" aria-controls="pane-system" aria-selected="false">
                <i class="bi bi-info-circle"></i><span data-i18n="settings.tab.system">系统信息</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-config" data-bs-toggle="tab" data-bs-target="#pane-config" type="button" role="tab" aria-controls="pane-config" aria-selected="false">
                <i class="bi bi-file-earmark-arrow-up-down"></i><span data-i18n="settings.tab.config">配置导入导出</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-database" data-bs-toggle="tab" data-bs-target="#pane-database" type="button" role="tab" aria-controls="pane-database" aria-selected="false">
                <i class="bi bi-database"></i><span data-i18n="settings.tab.database">数据库</span>
            </button>
        </li>
    </ul>

    <div class="tab-content settings-tab-content" id="settings-tab-content">
        <!-- TAB: 账号安全 (2FA) -->
        <div class="tab-pane fade show active" id="pane-security" role="tabpanel" aria-labelledby="tab-security">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-shield-lock"></i></span>
                        <span data-i18n="twofa.title">双因素认证 (2FA)</span>
                    </div>
                    <span id="twofa-status-badge" class="settings-status-badge" data-i18n="common.loading">加载中</span>
                </div>
                <div id="twofa-content" class="settings-panel-body">
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <div class="loading-text" data-i18n="common.loading">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: 日志与数据持久化 -->
        <div class="tab-pane fade" id="pane-logging" role="tabpanel" aria-labelledby="tab-logging">
            <!-- 持久化与保留策略 -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--blue"><i class="bi bi-database-check"></i></span>
                        <span data-i18n="settings.logging.group.persistence">持久化与保留策略</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ls-persistence">
                                <label class="form-check-label" for="ls-persistence" data-i18n="settings.logging.persistenceEnabled">日志持久化</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.persistenceEnabled.desc">关闭后日志仅在内存中保留，不写入数据库。</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-meta-retention" data-i18n="settings.logging.metaRetentionDays">元数据保留天数</label>
                            <input type="number" class="form-control" id="ls-meta-retention" min="1" max="365">
                            <div class="settings-field-hint">1 - 365 天</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-body-retention" data-i18n="settings.logging.bodyRetentionDays">大字段保留天数</label>
                            <input type="number" class="form-control" id="ls-body-retention" min="1" max="365">
                            <div class="settings-field-hint">1 - 365 天</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 请求/响应体捕获 -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-file-earmark-text"></i></span>
                        <span data-i18n="settings.logging.group.bodyCapture">请求/响应体捕获</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-req-body">
                                <label class="form-check-label" for="ls-req-body" data-i18n="settings.logging.requestBodyCapture">请求体捕获</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ls-resp-body">
                                <label class="form-check-label" for="ls-resp-body" data-i18n="settings.logging.responseBodyCapture">响应体捕获</label>
                            </div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-max-body" data-i18n="settings.logging.maxBodyLength">Body 最大长度</label>
                            <input type="number" class="form-control" id="ls-max-body" min="1024" step="1024">
                            <div class="settings-field-hint">字节</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-buffer" data-i18n="settings.logging.maxBodyBufferBytes">Body 缓冲区</label>
                            <input type="number" class="form-control" id="ls-buffer" min="1024" step="1024">
                            <div class="settings-field-hint">字节</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 采样与过滤 -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-funnel"></i></span>
                        <span data-i18n="settings.logging.group.sampling">采样与过滤</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-sampling">
                                <label class="form-check-label" for="ls-sampling" data-i18n="settings.logging.samplingEnabled">启用采样</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.samplingEnabled.desc">仅按比例记录日志，降低存储压力。</div>
                            <label class="form-label mt-2" for="ls-sampling-rate" data-i18n="settings.logging.samplingRate">采样率</label>
                            <input type="number" class="form-control" id="ls-sampling-rate" min="0.01" max="1" step="0.01">
                            <div class="settings-field-hint">0.01 - 1.0</div>
                        </div>
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-errors-only">
                                <label class="form-check-label" for="ls-errors-only" data-i18n="settings.logging.errorsOnly">仅记录错误</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.errorsOnly.desc">仅记录状态码 ≥ 400 的请求。</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-min-level" data-i18n="settings.logging.minLogLevel">最小日志级别</label>
                            <select class="form-select" id="ls-min-level">
                                <option value="Trace" data-i18n="settings.logging.level.trace">Trace</option>
                                <option value="Information" data-i18n="settings.logging.level.information">Information</option>
                                <option value="Warning" data-i18n="settings.logging.level.warning">Warning</option>
                                <option value="Error" data-i18n="settings.logging.level.error">Error</option>
                                <option value="Critical" data-i18n="settings.logging.level.critical">Critical</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 操作按钮 -->
            <div class="settings-bottom-bar">
                <div class="settings-bottom-bar-left">
                    <span id="settings-customized-badge" class="settings-status-badge settings-status-badge--warning d-none" data-i18n="settings.logging.customizedBadge">已自定义</span>
                </div>
                <div class="settings-bottom-bar-right">
                    <button class="btn btn-outline-secondary btn-sm" id="settings-reset-btn" onclick="SettingsModule.reset()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i><span data-i18n="settings.logging.reset">重置为默认</span>
                    </button>
                    <button class="btn btn-primary btn-sm" id="settings-save-btn" onclick="SettingsModule.save()">
                        <i class="bi bi-check-lg me-1"></i><span data-i18n="settings.logging.save">保存日志设置</span>
                    </button>
                </div>
            </div>

            <!-- 需重启配置 -->
            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-arrow-repeat"></i></span>
                        <span data-i18n="settings.logging.restartRequired">需重启生效的配置</span>
                        <span class="settings-read-only-badge" data-i18n="settings.logging.restartRequired.badge">只读 · appsettings.json</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="settings.logging.restartRequired.desc">以下配置来自 appsettings.json，修改后需重启服务才能生效。</div>
                    <div id="settings-restart-required" class="restart-required-grid"></div>
                </div>
            </div>
        </div>

        <!-- TAB: 系统信息 -->
        <div class="tab-pane fade" id="pane-system" role="tabpanel" aria-labelledby="tab-system">
            <div class="settings-panel">
                <div class="settings-panel-body" id="settings-system-content">
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <div class="loading-text" data-i18n="pluginPage.loading">加载中...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: 配置导入导出 -->
        <div class="tab-pane fade" id="pane-config" role="tabpanel" aria-labelledby="tab-config">
            <!-- 导出配置 -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-download"></i></span>
                        <span data-i18n="config.export">导出配置</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="config.exportDesc">将当前网关配置导出为 JSON 文件</div>
                    <div class="mt-3">
                        <button class="btn btn-outline-success btn-sm" id="config-export-btn" onclick="SettingsModule.exportConfig()">
                            <i class="bi bi-download me-1"></i><span data-i18n="config.exportBtn">导出</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 导入配置 -->
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-upload"></i></span>
                        <span data-i18n="config.import">导入配置</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="config.importDesc">从 JSON 文件导入网关配置</div>

                    <!-- 拖拽上传区域 -->
                    <div id="config-import-dropzone" class="config-import-dropzone">
                        <input type="file" id="config-import-file" accept=".json,application/json" style="display:none;">
                        <div class="config-import-dropzone-content">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span data-i18n="config.dropFile">拖拽文件到这里或点击选择</span>
                            <span class="text-muted small" data-i18n="config.selectJsonFile">请选择JSON文件</span>
                        </div>
                    </div>

                    <!-- 导入清单预览 -->
                    <div id="config-import-manifest" class="config-import-manifest d-none">
                        <div class="config-import-manifest-header">
                            <span class="config-import-manifest-title">
                                <i class="bi bi-clipboard-check"></i>
                                <span data-i18n="config.importManifest">导入清单</span>
                            </span>
                            <span id="config-import-summary" class="config-import-summary"></span>
                        </div>
                        <div class="config-import-manifest-body">
                            <div id="config-manifest-routes" class="config-manifest-section">
                                <div class="config-manifest-section-title">
                                    <i class="bi bi-signpost-2"></i>
                                    <span data-i18n="config.importManifestRoutes">路由清单</span>
                                    <span id="config-manifest-routes-count" class="badge bg-primary"></span>
                                </div>
                                <div id="config-manifest-routes-list" class="config-manifest-list"></div>
                            </div>
                            <div id="config-manifest-clusters" class="config-manifest-section">
                                <div class="config-manifest-section-title">
                                    <i class="bi bi-diagram-3"></i>
                                    <span data-i18n="config.importManifestClusters">集群清单</span>
                                    <span id="config-manifest-clusters-count" class="badge bg-info"></span>
                                </div>
                                <div id="config-manifest-clusters-list" class="config-manifest-list"></div>
                            </div>
                        </div>
                        <div class="config-import-manifest-desc" data-i18n="config.importManifestDesc">以上是将要导入的配置清单，请确认后继续</div>
                        <div class="config-import-manifest-actions">
                            <button class="btn btn-outline-secondary btn-sm" id="config-import-back" onclick="SettingsModule.resetImportFile()">
                                <i class="bi bi-arrow-left me-1"></i><span data-i18n="config.importManifestBack">返回重选</span>
                            </button>
                            <button class="btn btn-primary btn-sm" id="config-import-confirm" onclick="SettingsModule.confirmImportConfig()">
                                <i class="bi bi-check-lg me-1"></i><span data-i18n="config.importManifestContinue">确认导入</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: 数据库 -->
        <div class="tab-pane fade" id="pane-database" role="tabpanel" aria-labelledby="tab-database">
            <!-- 数据库信息 -->
            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-info-circle"></i></span>
                        <span data-i18n="settings.db.info">数据库信息</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="db-info-grid">
                        <div class="db-info-item">
                            <span class="db-info-label" data-i18n="settings.db.fileName">文件名</span>
                            <span class="db-info-value" id="db-info-name">—</span>
                        </div>
                        <div class="db-info-item">
                            <span class="db-info-label" data-i18n="settings.db.fileSize">文件大小</span>
                            <span class="db-info-value" id="db-info-size">—</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 下载 vs 备份 并排 -->
            <div class="db-actions-grid">
                <!-- 数据库下载 -->
                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div class="settings-panel-title">
                            <span class="settings-panel-icon settings-panel-icon--cyan"><i class="bi bi-download"></i></span>
                            <span data-i18n="settings.db.download">数据库下载</span>
                        </div>
                    </div>
                    <div class="settings-panel-body">
                        <div class="settings-field-desc mb-2" data-i18n="settings.db.downloadDesc">直接复制当前数据库文件到本地，速度快但可能不包含 WAL 未提交数据</div>
                        <div class="db-feature-list">
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.fast">速度快，直接文件拷贝</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-x text-danger"></i>
                                <span data-i18n="settings.db.feat.maybeInconsistent">可能不包含 WAL 日志数据</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-x text-danger"></i>
                                <span data-i18n="settings.db.feat.noTimestamp">文件名不含时间戳</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary btn-sm" onclick="SettingsModule.downloadDatabase()">
                                <i class="bi bi-download me-1"></i><span data-i18n="settings.db.downloadBtn">下载数据库</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 数据库备份 -->
                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div class="settings-panel-title">
                            <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-shield-check"></i></span>
                            <span data-i18n="settings.db.backup">数据库备份</span>
                        </div>
                    </div>
                    <div class="settings-panel-body">
                        <div class="settings-field-desc mb-2" data-i18n="settings.db.backupDesc">使用 VACUUM INTO 创建事务一致性快照，WAL 日志已合并，适合长期存档</div>
                        <div class="db-feature-list">
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.consistent">事务一致性快照</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.walMerged">WAL 日志已合并到单文件</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.timestamp">文件名含时间戳，便于版本管理</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm" id="config-backup-btn" onclick="SettingsModule.backupDatabase()">
                                <i class="bi bi-shield-check me-1"></i><span data-i18n="settings.db.backupBtn">备份数据库</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 对比表 -->
            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-table"></i></span>
                        <span data-i18n="settings.db.comparison">下载 vs 备份对比</span>
                    </div>
                </div>
                <div class="settings-panel-body p-0">
                    <table class="table table-sm mb-0 db-comparison-table">
                        <thead>
                            <tr>
                                <th data-i18n="settings.db.comp.feature">特性</th>
                                <th data-i18n="settings.db.download">数据库下载</th>
                                <th data-i18n="settings.db.backup">数据库备份</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-i18n="settings.db.comp.consistency">数据一致性</td>
                                <td><i class="bi bi-dash text-warning"></i> <span data-i18n="settings.db.comp.maybe">取决于 WAL 状态</span></td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.guaranteed">事务保证</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.wal">WAL 日志</td>
                                <td><i class="bi bi-x text-danger"></i> <span data-i18n="settings.db.comp.notIncluded">不含</span></td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.merged">已合并</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.speed">速度</td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.fast">快</span></td>
                                <td><i class="bi bi-clock text-warning"></i> <span data-i18n="settings.db.comp.slower">稍慢</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.filename">文件名</td>
                                <td><code>gateway-store.db</code></td>
                                <td><code>gateway-store-backup-{timestamp}.db</code></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.scenario">适用场景</td>
                                <td data-i18n="settings.db.comp.quickInspect">快速查看数据库内容</td>
                                <td data-i18n="settings.db.comp.archiveRecovery">长期存档、灾难恢复</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-settings.js"></script>
<!-- QRCode for 2FA setup (vendored locally - no CDN dependency for intranet) -->
<script src="/_content/Aneiang.Yarp.Dashboard/js/vendor/qrcode.min.js" onerror="console.warn('[2FA] local qrcode lib failed to load, will fall back to manual secret entry')"></script>
<!-- Two-factor authentication module (account security card) -->
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-twofactor.js"></script>
@await Html.PartialAsync("_DashboardPageInit")
<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        await SettingsModule.load();
        if (window.TwoFactorModule) {
            TwoFactorModule.load().catch(function() {});
        }
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

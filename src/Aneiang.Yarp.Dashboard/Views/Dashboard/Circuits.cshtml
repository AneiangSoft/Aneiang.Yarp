@using Aneiang.Yarp.Plugin.ProxyLog.Models
@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Circuit Breaker" : "熔断状态";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="circuits-app">
    <div class="page-help-bar" id="circuits-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.circuits">熔断器监控页面，展示每个集群的熔断状态。当后端服务异常时，熔断器会自动断开请求以保护系统。</span>
        <button class="help-close" onclick="document.getElementById('circuits-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-lightning-charge me-2" style="color:#f59e0b;"></i><span data-i18n="circuit.title">熔断状态</span></span>
            <div class="card-header-actions">
                <span id="circuit-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-primary" onclick="CircuitModule.load()" data-i18n-title="index.btn.refresh" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" onclick="CircuitModule.resetAll()" data-i18n-title="circuit.reset" title="重置">
                    <i class="bi bi-x-circle"></i> <span data-i18n="circuit.reset">全部重置</span>
                </button>
            </div>
        </div>
        <div id="circuit-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="circuit.loading">加载中...</div>
            </div>
        </div>
    </div>

    <!-- Configuration panel -->
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-gear me-2 text-secondary"></i><span data-i18n="circuit.config.title">熔断器配置</span></span>
            <div class="card-header-actions">
                <span id="cb-config-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-primary btn-icon-only" onclick="CircuitBreakerConfigModule.load()" title="刷新" aria-label="刷新">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div id="cb-config-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="common.loading">加载中...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{ var v = typeof(LogEntry).Assembly.GetName().Version?.ToString() ?? DateTime.Now.Ticks.ToString(); }
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-circuits.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/plugin-binding-manager.js"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-circuit-breaker-config.js"></script>

@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        if (window.DashboardApp && window.DashboardApp.modules && window.DashboardApp.modules.circuit) {
            await DashboardApp.modules.circuit.init();
        }
        await CircuitModule.load();
        await CircuitBreakerConfigModule.load();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}

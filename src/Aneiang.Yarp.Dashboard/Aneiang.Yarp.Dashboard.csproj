<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Aneiang.Yarp.Dashboard</PackageId>
    <Description>YARP gateway dashboard UI with authorization, real-time cluster/routes monitoring and log viewer.</Description>
    <PackageTags>yarp;reverse-proxy;gateway;dashboard;monitoring;dotnet</PackageTags>
  </PropertyGroup>

  <Target Name="DiscoverPrecompressedAssets" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aneiang.Yarp\Aneiang.Yarp.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.Abstractions\Aneiang.Yarp.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Storage.Abstractions\Aneiang.Yarp.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.Waf\Aneiang.Yarp.Plugin.Waf.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.Retry\Aneiang.Yarp.Plugin.Retry.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.CircuitBreaker\Aneiang.Yarp.Plugin.CircuitBreaker.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.RateLimit\Aneiang.Yarp.Plugin.RateLimit.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.ProxyLog\Aneiang.Yarp.Plugin.ProxyLog.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.Cache\Aneiang.Yarp.Plugin.Cache.csproj" />
    <ProjectReference Include="..\Aneiang.Yarp.Plugin.ServiceDiscovery\Aneiang.Yarp.Plugin.ServiceDiscovery.csproj" />

    <ProjectReference Include="..\Aneiang.Yarp.Plugin.Metrics\Aneiang.Yarp.Plugin.Metrics.csproj" />
  </ItemGroup>

  <!-- Plugin module files have been migrated to plugin projects and deleted from Dashboard. -->

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\I18n\zh-CN\*.json" />
    <EmbeddedResource Include="Infrastructure\I18n\en-US\*.json" />
  </ItemGroup>

</Project>
